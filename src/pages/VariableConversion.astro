      crossorigin="anonymous"></script>
    <script
      src="https://cdn.jsdelivr.net/npm/clipboard@2.0.11/dist/clipboard.min.js"
      integrity="sha256-4XodgW4TwIJuDtf+v6vDJ39FVxI0veC/kSCCmnFp7ck="
      crossorigin="anonymous"></script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const variableInput = document.querySelector("#variable-input");
        const pasteButton = document.querySelector("#paste-btn");
        const camelCaseInput = document.querySelector("#camel-case-input");
        const kebabCaseInput = document.querySelector("#kebab-case-input");
        const snakeCaseInput = document.querySelector("#snake-case-input");
        const startCaseInput = document.querySelector("#start-case-input");
        const upperCaseInput = document.querySelector("#upper-case-input");
        const lowerCaseInput = document.querySelector("#lower-case-input");

        variableInput.addEventListener("input", (event) => {
          const val = event.target.value;
          camelCaseInput.value = _.camelCase(val);
          kebabCaseInput.value = _.kebabCase(val);
          snakeCaseInput.value = _.snakeCase(val);
          startCaseInput.value = _.startCase(val);
          upperCaseInput.value = _.upperCase(val);
          lowerCaseInput.value = _.lowerCase(val);
        });

        const clipboard = new ClipboardJS(".btn");

        pasteButton.addEventListener("click", () => {
          if (!navigator.clipboard || !navigator.clipboard.readText) {
            return;
          }

          navigator.clipboard
            .readText()
            .then((clipboardText) => {
              variableInput.value = clipboardText;

              camelCaseInput.value = _.camelCase(clipboardText);
              kebabCaseInput.value = _.kebabCase(clipboardText);
              snakeCaseInput.value = _.snakeCase(clipboardText);
              startCaseInput.value = _.startCase(clipboardText);
              upperCaseInput.value = _.upperCase(clipboardText);
              lowerCaseInput.value = _.lowerCase(clipboardText);
            })
            .catch((err) => {
              console.error("无法从剪贴板读取文本: ", err);
              alert(
                "粘贴失败！请检查浏览器权限，并确保页面是通过 HTTPS 访问的。"
              );
            });
        });
      });
    </script>
